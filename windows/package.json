{
  "name": "flits",
  "version": "1.6.0",
  "description": "Flits - bestanden direct tussen je telefoon en pc",
  "main": "src/main.js",
  "author": "Flits",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "selfsigned": "^2.4.1"
  },
  "build": {
    "appId": "nl.flits.app",
    "productName": "Flits",
    "copyright": "Flits",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Flits.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Flits",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Flits.exe",
      "differentialPackage": false
    }
  }
}